PORT=3000
DATABASE_URL="file:./dev.db"
JWT_SECRET="super-secret-jwt-key-for-dev"
JWT_EXPIRES_IN="1d"
CLIENT_URL="http://localhost:5173"

MAX_BULK_STUDENTS=500
EXECUTION_TIMEOUT_MS=5000
EXECUTION_OUTPUT_LIMIT=100000
MAX_SOURCE_CODE_SIZE=100000
MAX_EXECUTION_INPUT_SIZE=100000
MAX_CONCURRENT_EXECUTIONS=5

# AI Configuration (Optional, set USE_MOCK_AI=true for testing without an API key)
USE_MOCK_AI="false"
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama3-8b-8192"
